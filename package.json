{
  "name": "agenttraceback-workspace",
  "version": "0.1.0-alpha.2",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @agenttraceback/desktop build",
    "build:daemon": "cargo build -p agenttraceback-daemon",
    "dev": "cargo run -p xtask -- sidecars && pnpm --filter @agenttraceback/desktop tauri dev",
    "lint": "pnpm --filter @agenttraceback/desktop lint",
    "test": "pnpm --filter @agenttraceback/desktop test",
    "typecheck": "pnpm --filter @agenttraceback/desktop typecheck"
  }
}
